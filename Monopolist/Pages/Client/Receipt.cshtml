@page
@model Monoplist.Pages.Client.ReceiptModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Чек № @Model.OrderNumber – Моноплист</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
        :root {
            --primary: #FF6B00;
            --primary-dark: #E05E00;
            --primary-light: #FF9500;
            --accent: #FFD700;
            --bg: #f8f9fc;
            --surface: #ffffff;
            --surface-hover: #f8fafc;
            --text-primary: #1e293b;
            --text-secondary: #334155;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text-primary);
            line-height: 1.5;
            padding: 20px;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .receipt-container {
            max-width: 600px;
            margin: 0 auto;
            background: var(--surface);
            border-radius: 16px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.1);
            padding: 30px;
            border: 1px solid var(--border);
        }

        .receipt-header {
            text-align: center;
            margin-bottom: 24px;
            position: relative;
        }

        .logo {
            font-size: 40px;
            color: var(--primary);
            margin-bottom: 10px;
        }

        .company-name {
            font-size: 24px;
            font-weight: 700;
            color: var(--primary);
            margin: 0;
        }

        .company-info {
            font-size: 12px;
            color: var(--text-muted);
        }

        .receipt-title {
            text-align: center;
            font-size: 20px;
            font-weight: 700;
            margin: 20px 0 10px;
            color: var(--primary);
            border-bottom: 2px solid var(--accent);
            padding-bottom: 10px;
        }

        .order-meta {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            color: var(--text-secondary);
            margin-bottom: 16px;
        }

            .order-meta span {
                display: block;
            }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 16px 0;
        }

        th {
            background: var(--primary);
            color: white;
            font-weight: 600;
            padding: 10px;
            text-align: left;
            font-size: 13px;
        }

        td {
            padding: 10px;
            border-bottom: 1px solid var(--border);
            font-size: 13px;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .total-row td {
            font-weight: bold;
            font-size: 15px;
            background: var(--surface-hover);
            border-top: 2px solid var(--primary);
        }

        .payment-info {
            text-align: right;
            font-size: 13px;
            color: var(--text-secondary);
            margin-top: 10px;
        }

        .action-buttons {
            display: flex;
            gap: 12px;
            justify-content: center;
            margin-top: 24px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 24px;
            border-radius: 40px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
            border: none;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
        }

            .btn-primary:hover {
                background: var(--primary-dark);
                transform: translateY(-2px);
            }

        .btn-secondary {
            background: var(--surface);
            color: var(--text-secondary);
            border: 2px solid var(--border);
        }

            .btn-secondary:hover {
                border-color: var(--primary);
                color: var(--primary);
                background: var(--surface-hover);
            }

        .footer-note {
            text-align: center;
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 20px;
            border-top: 1px solid var(--border);
            padding-top: 15px;
        }

        @@media print {
            body {
                background: white;
                padding: 0;
            }

            .receipt-container {
                box-shadow: none;
                border: none;
                padding: 0;
                max-width: 100%;
            }

            .action-buttons {
                display: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="receipt-container">
        <div class="receipt-header">
            <div class="logo">
                <i class="fas fa-helmet-safety"></i>
            </div>
            <h1 class="company-name">Моноплист</h1>
            <p class="company-info">Строительные материалы | г. Москва, ул. Строителей, д. 10</p>
            <p class="company-info">ИНН 1234567890 | ОГРН 1234567890123</p>
        </div>

        <h2 class="receipt-title">Чек № @Model.OrderNumber</h2>

        <div class="order-meta">
            <span>Дата: @Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</span>
            <span>Клиент: @Model.CustomerName</span>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Товар</th>
                    <th>Кол-во</th>
                    <th>Цена</th>
                    <th>Сумма</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Quantity @item.Unit</td>
                        <td>@item.Price.ToString("N2") ₽</td>
                        <td>@item.Total.ToString("N2") ₽</td>
                    </tr>
                }
                <tr class="total-row">
                    <td colspan="3" style="text-align:right;">ИТОГО:</td>
                    <td>@Model.TotalAmount.ToString("N2") ₽</td>
                </tr>
            </tbody>
        </table>

        <p class="payment-info">Способ оплаты: @Model.PaymentMethodText</p>

        <div class="action-buttons">
            <button class="btn btn-primary" onclick="window.print()"><i class="fas fa-print"></i> Печать</button>
            <a href="/Client/Orders" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> К заказам</a>
            <button class="btn btn-secondary" onclick="window.close()"><i class="fas fa-times"></i> Закрыть</button>
        </div>

        <div class="footer-note">
            Спасибо за покупку! Ждём вас снова.
        </div>
    </div>

    <script>
        window.onload = function() {
            window.print(); // автоматический вызов печати при открытии
        }
    </script>
</body>
</html>